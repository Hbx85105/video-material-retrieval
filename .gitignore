# Python 运行产生的临时文件
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境（占用空间大，不进仓库）
.venv/
venv/
env/

# 大体积素材和生成物（只保留样片目录的说明文件）
data/samples/*.mp4
data/samples/*.mov
data/samples/*.mkv
data/frames/
data/vectors/

# 系统文件
.DS_Store
Thumbs.db

# WorkBuddy 工具的内部记录（跟项目无关，不进仓库）
.workbuddy/

# 测试用的微信视频（虽然后缀是 txt，实际是大视频）
data/samples/微信视频*.txt
